# systemd *user* service template. The instance name (%i) is the Reachy
# Mini host. Audio relies on the user's PulseAudio/PipeWire session, so
# this must run as a user unit, not a system one:
#
#   systemctl --user enable --now reachy-mini-cam-relay@<reachy-host>
#   journalctl --user -u reachy-mini-cam-relay@<reachy-host>

[Unit]
Description=Reachy Mini camera/mic/speaker relay (%i)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/reachy-mini-cam-relay --reachy-host %i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
